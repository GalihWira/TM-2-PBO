<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.FormController" alignment="CENTER" spacing="10">
    <Label text="Pendaftaran Seminar PBO"/>
    <TextField fx:id="txtNama" promptText="Masukkan nama" maxWidth="250"/>
    <Button text="Simpan" onAction="#klikSimpan"/>
    <Label fx:id="lblStatus"/>
</VBox>